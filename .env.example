POSTGRES_USER=residuum
POSTGRES_PASSWORD=residuum
POSTGRES_DB=residuum
POSTGRES_PORT=5433

API_PORT=8080
SECRET_KEY=troque-esta-chave-em-producao

# Usado para rodar o backend fora do Docker, apontando para o Postgres local.
DATABASE_URL=postgresql://residuum:residuum@localhost:5433/residuum

# Campanhas: true credita os pontos na adesao (comportamento atual); false so registra a adesao (PD-011).
CAMPANHA_BONUS_NA_ADESAO=true
